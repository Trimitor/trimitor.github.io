  <div class="d-flex flex-wrap justify-content-center gap-2 mb-3">
    <select class="form-select form-select-sm w-auto" id="expansion0">
      <option selected disabled>Eastern Kingdoms</option>
    </select>
    <select class="form-select form-select-sm w-auto" id="expansion1">
      <option selected disabled>Kalimdor</option>
    </select>
    <select class="form-select form-select-sm w-auto" id="expansion2">
      <option selected disabled>Outland</option>
    </select>
    <select class="form-select form-select-sm w-auto" id="expansion3">
      <option selected disabled>Northrend</option>
    </select>
  </div>

  <div class="d-flex flex-wrap justify-content-center gap-2 mb-3">
    <select class="form-select form-select-sm w-auto" id="expansion4">
      <option selected disabled>Dungeons</option>
    </select>
    <select class="form-select form-select-sm w-auto" id="expansion5">
      <option selected disabled>Raids</option>
    </select>
    <select class="form-select form-select-sm w-auto" id="expansion6">
      <option selected disabled>Battlegrounds</option>
    </select>
  </div>

  <!-- Основной рабочий блок -->
  <div class="row gx-4">
    <!-- Левая часть -->
    <div class="col-lg-8">
      <div class="border rounded-3 bg-dark p-3 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
          <p class="small mb-0">
            {{t.mohelper_control}} |
            <a href="javascript:void(0);" id="clearAll">Clear All</a>
          </p>
          <div class="d-flex gap-2 align-items-center">
            <button id="addArea" class="btn btn-sm btn-outline-primary">{{t.mohelper_new_area}}</button>
            <select id="areaSelect" class="form-select form-select-sm w-auto"></select>
            <select class="form-select form-select-sm w-auto" id="floors">
              <option selected disabled>{{t.mohelper_select_floor}}</option>
            </select>
          </div>
        </div>

        <!-- Карта -->
        <div id="map" class="rounded-3 shadow-sm">
          <canvas id="canvas"></canvas>
        </div>
      </div>
    </div>

    <!-- Правая часть -->
    <div class="col-lg-4">
      <div class="border rounded-3 bg-dark p-3 shadow-sm h-100">
        <select class="form-select form-select-sm mb-3" id="dungeons">
          <option selected disabled>{{t.mohelper_select_dungeon}}</option>
        </select>

        <select class="form-select form-select-sm mb-3" id="quests">
          <option selected disabled>{{t.mohelper_select_quest}}</option>
        </select>

        <label class="form-label fw-bold mb-1">{{t.mohelper_wh_link}}</label>
        <div id="wh-link" class="mb-3"></div>

        <div class="mb-3">
          <label class="form-label fw-bold mb-1">{{t.mohelper_idx}}</label>
          <input type="number" class="form-control" id="start-iteration">
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold mb-1">quest_poi</label>
          <textarea class="form-control" name="qp" rows="4"></textarea>
        </div>

        <div>
          <label class="form-label fw-bold mb-1">quest_poi_points</label>
          <textarea class="form-control" name="qpp" rows="6"></textarea>
        </div>
      </div>
    </div>
  </div>
</div>
